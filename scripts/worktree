#!/bin/bash
# pflow worktree — parallel git worktrees for task and issue lanes.
#
# Usage:
#   ./scripts/worktree new <branch> [base-ref] [--copy <path>]... [--no-open] [--claude|--codex ["context"]] [--model <name>]
#       Create ../pflow-worktrees/<slug> on <branch> (a new branch from base-ref, or an existing
#       one), run `make install`, open Cursor there (default; --no-open suppresses), copy files or
#       folders in (--copy, repeatable, repo-relative, location preserved — for gitignored
#       scratchpads a fresh checkout won't have), and optionally launch a coding agent in a new
#       Terminal window with the given context. A context starting with "/" or "$" is passed
#       through verbatim as the agent's instruction; plain text is framed as the task.
#       base-ref defaults to main ONLY when the MAIN checkout is on main (wherever this runs from);
#       on any other branch it must be given explicitly, so a worktree never silently branches
#       off unmerged work. A local main behind origin/main is warned about, not refused.
#   ./scripts/worktree rm <branch|path> [-f]
#       Remove a worktree whose PR has MERGED — squash-safe: the merged PR's head SHA (via gh) must
#       equal the branch tip, and the tree must be clean (a refusal lists the dirty paths); the
#       branch is deleted too. -f discards local state only: it removes the tree even when dirty,
#       but still deletes the branch only when the merge verifies — otherwise it keeps the branch
#       and says why. Refuses (even with -f) while any process has its cwd inside the worktree
#       (a stale `pflow ui` server is the usual one) — stop it first; never kill it from here.
#   ./scripts/worktree list
#       Worktrees of this repo with branch, tip, and merged-PR state.
#
# What stays manual discipline: collision analysis before any parallel launch, never mutating
# shared tooling while producers are live, and the second branch to merge re-running its
# code-mode review on the rebased diff (ORCHESTRATION.md).
#
# Environment (tests and dry runs): PFLOW_WORKTREES_DIR overrides ../pflow-worktrees;
# WORKTREE_NO_LAUNCH=1 prints the agent command instead of opening Terminal/Cursor.

set -euo pipefail

# The MAIN checkout, wherever this is invoked from: `--show-toplevel` answers with the CURRENT
# worktree, so `rm` run from inside one would point `git worktree` at the wrong checkout;
# `--git-common-dir` is the same directory from anywhere in the repo.
REPO_ROOT="$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")"
WORKTREES_DIR="${PFLOW_WORKTREES_DIR:-$REPO_ROOT-worktrees}"

die() { echo "error: $*" >&2; exit 1; }

usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print } /^set -euo/ { exit }' "$0"; }

slugify() { # branch name -> directory slug (feat/task-94-model-list -> feat-task-94-model-list)
  echo "$1" | tr '[:upper:]/' '[:lower:]-' | tr -cd 'a-z0-9-'
}

dir_for() { # branch or path -> worktree directory; a branch's slug wins over a same-named repo dir (docs/reference is both)
  local slug_dir="$WORKTREES_DIR/$(slugify "$1")"
  if [ -d "$slug_dir" ]; then echo "$slug_dir"; elif [ -d "$1" ]; then (cd "$1" && pwd); else echo "$slug_dir"; fi
}

merged_head() { # branch -> head SHA of its MERGED PR, or empty (squash merges make `git branch --merged` lie).
  # Exit 2 = gh missing or failed (offline, unauthenticated) — distinct from "no merged PR", so a
  # caller never reports an unanswerable query as "unmerged".
  command -v gh >/dev/null 2>&1 || return 2
  gh pr list --state merged --head "$1" --json headRefOid -q '.[0].headRefOid // empty' 2>/dev/null || return 2
}

merge_problem() { # <branch> <tip> -> empty when the branch's merged PR head == tip, else why not (one line)
  local merged rc=0
  merged="$(merged_head "$1")" || rc=$?
  if [ "$rc" -ne 0 ]; then echo "could not query gh for a merged PR of '$1' (gh missing, unauthenticated, or offline)"
  elif [ -z "$merged" ]; then echo "no MERGED PR found for branch '$1' (gh)"
  elif [ "$merged" != "$2" ]; then echo "merged PR head $merged != branch tip $2 — the branch moved after the merge"
  fi
}

cwd_blockers() { # dir -> "pid=N cwd=PATH" lines for processes rooted inside dir (read-only: report, never signal)
  command -v lsof >/dev/null 2>&1 || return 0
  lsof -a -d cwd -Fpn 2>/dev/null | awk -v dir="$1" '
    /^p/ { pid = substr($0, 2) }
    /^n/ { path = substr($0, 2); if (path == dir || index(path, dir "/") == 1) printf "    pid=%s cwd=%s\n", pid, path }'
}

model_for_agent() { # <claude|codex> <model> -> runner model name; the Sonnet tier is retired (DECISIONS #24)
  local agent="$1" model="$2"
  case "$model" in
    sonnet*) die "the Sonnet tier is retired (DECISIONS #24) — use opus or fable" ;;
  esac
  if [ "$agent" = "codex" ]; then
    case "$model" in
      opus|fable) model="gpt-6-astra" ;;
    esac
  fi
  printf '%s\n' "$model"
}

copy_into() { # <worktree-dir> <path> — preserve the repo-relative location
  local dir="$1" src="$2" rel parent
  case "$src" in
    /*) ;;
    *) src="$REPO_ROOT/$src" ;;
  esac
  if [ ! -e "$src" ]; then
    echo "warning: --copy: $src not found, skipping" >&2
    return 0
  fi
  rel="${src#"$REPO_ROOT"/}"
  [ "$rel" != "$src" ] || rel="$(basename "$src")" # outside the repo -> land at the worktree root
  parent="$(dirname "$rel")"
  mkdir -p "$dir/$parent"
  cp -R "$src" "$dir/$parent/"
  echo "▸ copied $rel into the worktree"
}

launch_agent() { # <dir> <branch> <base> <claude|codex> [context] [model]
  local dir="$1" branch="$2" base="$3" agent="$4" context="${5:-}" model="${6:-}"
  local agent_cmd prompt runfile

  if [ "$agent" = "codex" ]; then
    agent_cmd="codex --sandbox workspace-write --ask-for-approval never"
  else
    agent_cmd="claude --dangerously-skip-permissions"
  fi
  [ -n "$model" ] && agent_cmd="$agent_cmd --model $(printf %q "$model")"

  prompt="You are working in a dedicated git worktree at $dir on branch $branch (base $base). Read CLAUDE.md first and run every command from this directory. Sibling worktrees may hold in-flight branches — read ORCHESTRATION.md \"Collision analysis\" before touching shared tooling."
  if [ -n "$context" ]; then
    case "$context" in
      /*|\$*) prompt="$prompt $context" ;;           # a slash command IS the instruction — verbatim
      *)      prompt="$prompt Task: $context." ;;
    esac
  fi
  [ "$agent" = "codex" ] && prompt="$prompt Use the sandbox-testing skill when you run pflow tests."

  if [ "${WORKTREE_NO_LAUNCH:-0}" = 1 ]; then
    echo "▸ (no-launch) would run in $dir: $agent_cmd '$prompt'"
    return 0
  fi

  # A temp runfile keeps ALL shell quoting inside printf %q — the AppleScript layer only ever
  # sees a plain path, so no prompt character can break the launch.
  runfile="$(mktemp /tmp/worktree-launch-XXXXXX)"
  {
    printf 'rm -f %q\n' "$runfile"
    printf 'cd %q || exit 1\n' "$dir"
    printf 'exec %s %q\n' "$agent_cmd" "$prompt"
  } > "$runfile"
  osascript -e 'tell application "Terminal"' -e 'activate' \
            -e "do script \"bash $runfile\"" -e 'end tell' >/dev/null
  echo "▸ $agent launched in a new Terminal window"
}

cmd_new() {
  local branch="" base="" open_cursor=1 agent="" context="" copies="" model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-open) open_cursor=0 ;;
      --model)
        [ $# -gt 1 ] || die "--model needs a value"
        model="$2"; shift ;;
      --copy)
        [ $# -gt 1 ] || die "--copy needs a path"
        copies="$copies$2"$'\n'; shift ;;
      --claude|--codex)
        agent="${1#--}"
        if [ $# -gt 1 ]; then
          case "$2" in
            --*) ;;
            *) context="$2"; shift ;;
          esac
        fi ;;
      --*) die "unknown flag: $1" ;;
      *)
        if [ -z "$branch" ]; then branch="$1"
        elif [ -z "$base" ]; then base="$1"
        else die "unexpected argument: $1"
        fi ;;
    esac
    shift
  done
  [ -n "$branch" ] || die "usage: scripts/worktree new <branch> [base-ref] [--copy <path>]... [--no-open] [--claude|--codex [\"context\"]] [--model <name>]"

  # Base guard: default to main only FROM main — otherwise a worktree silently branches off
  # unmerged work. To branch off a feature branch deliberately, name it.
  if [ -z "$base" ]; then
    local current
    current="$(git -C "$REPO_ROOT" branch --show-current)"
    [ "$current" = "main" ] || die "the main checkout is on '$current', not main — pass the base ref explicitly (usually: main)"
    base="main"
    # PRs merge on GitHub, so the local main is often behind — a worktree cut from it starts on
    # stale code and its rebase later pays for drift that was never needed.
    if git -C "$REPO_ROOT" rev-parse --verify --quiet origin/main >/dev/null \
       && ! git -C "$REPO_ROOT" merge-base --is-ancestor origin/main main; then
      echo "warning: local main is behind origin/main (as of the last fetch) — git pull first, or pass origin/main as the base" >&2
    fi
  fi
  # Everything that can refuse does so BEFORE the worktree exists — no half-provisioned tree to undo.
  if [ -n "$model" ]; then
    [ -n "$agent" ] || die "--model only applies alongside --claude or --codex"
    model="$(model_for_agent "$agent" "$model")"
  fi
  if [ -n "$agent" ] && [ "${WORKTREE_NO_LAUNCH:-0}" != 1 ]; then
    command -v osascript >/dev/null 2>&1 || die "--$agent opens a Terminal window via osascript (macOS) — not available here; create the worktree without it and launch the agent yourself"
  fi

  local dir
  dir="$WORKTREES_DIR/$(slugify "$branch")"
  [ ! -e "$dir" ] || die "$dir already exists — a different task needs a more specific branch name; the same task means: scripts/worktree rm first"
  mkdir -p "$WORKTREES_DIR"

  local created_branch=0
  echo "▸ creating worktree $dir (branch: $branch, base: $base)"
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$REPO_ROOT" worktree add "$dir" "$branch"
  else
    git -C "$REPO_ROOT" worktree add -b "$branch" "$dir" "$base"
    created_branch=1
  fi

  # Fail closed: a half-provisioned worktree is worse than none (an agent launched into it
  # silently operates on the wrong target), so a failed install removes what this run created.
  echo "▸ make install (uv's cache is shared — fast)"
  if ! (cd "$dir" && make install); then
    echo "▸ install failed — removing the half-provisioned worktree" >&2
    git -C "$REPO_ROOT" worktree remove --force "$dir" || true
    [ "$created_branch" = 1 ] && git -C "$REPO_ROOT" branch -D "$branch" >/dev/null 2>&1
    die "provisioning failed in $dir (see make output above); nothing was left behind"
  fi

  if [ -n "$copies" ]; then
    printf '%s' "$copies" | while IFS= read -r c; do
      [ -n "$c" ] && copy_into "$dir" "$c"
    done
  fi

  echo ""
  echo "worktree ready: $dir"
  echo "  branch:   $branch  (base: $base)"
  echo "  teardown: scripts/worktree rm $branch   (after its PR merges)"

  if [ "$open_cursor" = 1 ] && [ "${WORKTREE_NO_LAUNCH:-0}" != 1 ]; then
    open -a "Cursor" "$dir" 2>/dev/null && echo "▸ Cursor opened" || echo "warning: could not open Cursor" >&2
  fi
  if [ -n "$agent" ]; then
    launch_agent "$dir" "$branch" "$base" "$agent" "$context" "$model"
  fi
}

cmd_rm() {
  local target="${1:-}" force="${2:-}"
  [ -n "$target" ] || die "usage: scripts/worktree rm <branch|path> [-f]"
  local dir
  dir="$(dir_for "$target")"
  [ -d "$dir" ] || die "no worktree at $dir"
  [ "$dir" != "$REPO_ROOT" ] || die "refusing to remove the main checkout"

  local blockers
  blockers="$(cwd_blockers "$dir")"
  [ -z "$blockers" ] || die "a process is running inside $dir — stop it first (never kill a sibling's server from here):"$'\n'"$blockers"

  local branch tip dirty problem
  branch="$(git -C "$dir" branch --show-current)"
  tip="$(git -C "$dir" rev-parse HEAD)"
  dirty="$(git -C "$dir" status --porcelain | sed 's/^/    /')"

  if [ "$force" != "-f" ]; then
    [ -n "$branch" ] || die "worktree is on a detached HEAD — no branch to check a merged PR for; inspect, or -f to remove the tree"
    [ -z "$dirty" ] \
      || die "worktree is dirty — commit or stash there, or re-run with -f to discard these:"$'\n'"$dirty"
    problem="$(merge_problem "$branch" "$tip")"
    [ -z "$problem" ] || die "$problem; resolve it, or -f to remove the tree and keep the branch"
    echo "▸ removing worktree $dir (PR merged at $tip)"
    git -C "$REPO_ROOT" worktree remove "$dir"
    git -C "$REPO_ROOT" branch -D "$branch" >/dev/null
    echo "▸ branch $branch deleted"
    return 0
  fi

  # Forced: discard the working files, but the branch still goes only when its merge verifies —
  # force never leaves a merged branch behind, and never deletes an unverified one.
  [ -z "$dirty" ] || echo "▸ discarding local changes:"$'\n'"$dirty"
  problem=""
  [ -z "$branch" ] || problem="$(merge_problem "$branch" "$tip")"
  echo "▸ removing worktree $dir (forced)"
  git -C "$REPO_ROOT" worktree remove --force "$dir"
  if [ -z "$branch" ]; then
    echo "▸ detached HEAD — no branch to delete"
  elif [ -n "$problem" ]; then
    echo "warning: branch '$branch' kept — $problem" >&2
  else
    git -C "$REPO_ROOT" branch -D "$branch" >/dev/null
    echo "▸ branch $branch deleted (PR merged at $tip)"
  fi
}

cmd_list() {
  local path branch tip merged rc
  git -C "$REPO_ROOT" worktree list --porcelain | awk '/^worktree /{print $2}' | while IFS= read -r path; do
    branch="$(git -C "$path" branch --show-current 2>/dev/null || echo "?")"
    tip="$(git -C "$path" rev-parse --short HEAD 2>/dev/null || echo "?")"
    if [ "$path" = "$REPO_ROOT" ]; then
      merged="(main checkout)"
    else
      rc=0
      merged="$(merged_head "$branch")" || rc=$?
      if [ "$rc" -ne 0 ]; then merged="? (gh unavailable)"
      else merged="${merged:+merged}"; merged="${merged:-unmerged}"
      fi
    fi
    printf '%-60s %-40s %s  %s\n' "$path" "$branch" "$tip" "$merged"
  done
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  list) cmd_list ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $1 (new | rm | list)" ;;
esac
